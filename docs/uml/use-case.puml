@startuml
left to right direction
actor Administrator as Admin
rectangle "CampusDesk Student Management System" {
  usecase "Register account" as UC1
  usecase "Sign in" as UC2
  usecase "View dashboard" as UC3
  usecase "List / search students" as UC4
  usecase "View student details" as UC5
  usecase "Create student" as UC6
  usecase "Edit student" as UC7
  usecase "Delete student" as UC8
  usecase "Sign out" as UC9
}
Admin --> UC1
Admin --> UC2
Admin --> UC3
Admin --> UC4
Admin --> UC5
Admin --> UC6
Admin --> UC7
Admin --> UC8
Admin --> UC9
UC3 .> UC2 : requires authentication
UC4 .> UC2 : requires authentication
@enduml
