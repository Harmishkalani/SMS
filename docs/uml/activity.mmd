flowchart TD
    A([Start]) --> B[Open CampusDesk]
    B --> C{Authenticated?}
    C -- No --> D[Register or sign in]
    D --> E{Credentials valid?}
    E -- No --> D
    E -- Yes --> F[Dashboard]
    C -- Yes --> F
    F --> G[Open student directory]
    G --> H{Choose action}
    H -- Create --> I[Enter student details]
    H -- Search/filter --> J[Apply search or status filter]
    H -- Edit --> K[Update student details]
    H -- Delete --> L[Confirm deletion]
    I --> M{Server validation passes?}
    M -- No --> N[Show validation error]
    N --> I
    M -- Yes --> O[(Persist in MongoDB)]
    K --> M
    L --> P{Confirmed?}
    P -- No --> G
    P -- Yes --> O
    J --> Q[Render matching records]
    O --> R[Refresh records and dashboard]
    Q --> S([End / continue])
    R --> S
