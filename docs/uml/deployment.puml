@startuml
node "Administrator Device" {
  artifact "Web Browser" as Browser
}
node "Frontend Hosting" {
  artifact "Vite-built React static assets" as Static
}
node "Backend Server / Node.js" {
  artifact "Express REST API" as API
  artifact ".env configuration" as Env
}
database "MongoDB Server / Atlas" as DB
Browser --> Static : HTTPS
Browser --> API : HTTPS JSON API
API --> DB : MongoDB wire protocol / TLS
Env .. API : runtime configuration
@enduml
